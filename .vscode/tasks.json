// tasks.json
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "g++ build (debug)",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++20",
                "-g",
                "-O0",
                "-Wall",
                "-Wextra",
                "main.cpp",
                "domain.cpp",
                "geo.cpp",
                "json.cpp",
                "json_reader.cpp",
                "request_handler.cpp",
                "transport_catalogue.cpp",
                "map_renderer.cpp",
                "svg.cpp",
                "-o",
                "transport_catalogue"
            ],
            "options": {
                "cwd": "${workspaceFolder}/transport-catalogue"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}